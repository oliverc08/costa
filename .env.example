# Costa's default app, tests, and safety evaluation run without AI credentials
# and do not use Vercel AI Gateway.

# Optional: point at a local OpenAI-compatible model server, such as Ollama.
# Leave blank to use the deterministic FAQ and local-agent paths.
COSTA_LOCAL_LLM_URL=
COSTA_LOCAL_LLM_API_KEY=ollama
COSTA_CHAT_MODEL=llama3.2:1b
COSTA_VOICE_MODEL=llama3.2:1b
COSTA_VISION_MODEL=llama3.2:1b
COSTA_EMBEDDING_MODEL=nomic-embed-text

# Optional durable storage. Without this, server-side sessions and handoffs use
# temporary process memory and may be lost when the server restarts.
DATABASE_URL=

# Optional Twilio SMS and phone integration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=

# Partner dashboard: development falls back to the passcode "costa-demo".
# Set a private passcode when enabling the dashboard in production.
PARTNER_PASSCODE=
# Required in production for signed partner cookies and phone hashes.
SESSION_SECRET=

# Required for the scheduled purge endpoint. Configure the same secret in the
# hosting platform's cron authorization.
CRON_SECRET=
