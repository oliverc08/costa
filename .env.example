# Costa is local-first. No Vercel AI Gateway required.
#
# Optional: small local LLM via Ollama (OpenAI-compatible API)
# COSTA_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# COSTA_LOCAL_LLM_API_KEY=ollama
# COSTA_CHAT_MODEL=llama3.2:1b
# COSTA_VOICE_MODEL=llama3.2:1b
# COSTA_EMBEDDING_MODEL=nomic-embed-text

# Neon Postgres (optional locally; without it Costa uses an in-memory store)
DATABASE_URL=

# Twilio (SMS + voice) — agent uses the deterministic local path unless Ollama is set
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public base URL Twilio calls back to, e.g. https://costa-five.vercel.app
PUBLIC_BASE_URL=

# Partner dashboard passcode (dev default: costa-demo). Set in production for demos.
PARTNER_PASSCODE=costa-demo
# Signing secret (required in production: partner cookies + phone hashes)
SESSION_SECRET=

# Vercel Cron authorization for the 30-day purge job
CRON_SECRET=
