# Vercel AI Gateway (required for the agent, letters, voice transcription, and evals)
AI_GATEWAY_API_KEY=

# Optional model overrides (AI Gateway model ids)
# COSTA_CHAT_MODEL=anthropic/claude-sonnet-5
# COSTA_VOICE_MODEL=google/gemini-3.8-flash
# COSTA_VISION_MODEL=anthropic/claude-sonnet-5
# COSTA_JUDGE_MODEL=anthropic/claude-sonnet-5
# COSTA_EMBEDDING_MODEL=openai/text-embedding-3-small
# COSTA_TRANSCRIPTION_MODEL=openai/whisper-1

# Neon Postgres (optional locally; without it Costa uses an in-memory store)
DATABASE_URL=

# Twilio (SMS + voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public base URL Twilio calls back to, e.g. https://costa.vercel.app
PUBLIC_BASE_URL=

# Partner dashboard passcode and cookie signing secret
PARTNER_PASSCODE=
SESSION_SECRET=

# Vercel Cron authorization for the 30-day purge job
CRON_SECRET=
